// Secrets.xcconfig — Copy this file to Secrets.xcconfig and fill in your keys.
// DO NOT commit the real Secrets.xcconfig (it is gitignored).

RAWG_API_KEY = your_rawg_api_key_here

// Accounts, social, IGDB box art and Steam import go through the Gameboxd server (server/).
// Host and port only, no "http://": "//" starts a comment in .xcconfig files. With a port
// it's reached over http (the Mac on the Wi-Fi), without one over https.
SERVER_HOST = your-mac-name.local:8090

// IGDB and Steam keys are server secrets (server/.env), never build settings, because
// everything here ships inside the app.

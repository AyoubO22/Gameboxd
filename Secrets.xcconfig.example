// Secrets.xcconfig — Copy this file to Secrets.xcconfig and fill in your keys.
// DO NOT commit the real Secrets.xcconfig (it is gitignored).

RAWG_API_KEY = your_rawg_api_key_here

// Portrait box art (optional). Free Twitch app: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID = your_twitch_client_id
IGDB_CLIENT_SECRET = your_twitch_client_secret

// Accounts and social (Supabase → Project Settings → API). Host only, no "https://":
// "//" starts a comment in .xcconfig files. Never put the service_role key here.
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your_supabase_anon_key

// Steam library import (optional). https://steamcommunity.com/dev/apikey
STEAM_API_KEY = your_steam_web_api_key
